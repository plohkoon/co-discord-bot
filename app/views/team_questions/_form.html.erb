<%# question is either persisted (edit) or a new record (add). %>
<div class="rounded-lg border border-border bg-card p-3">
  <%= form_with model: question,
        url: (question.persisted? ? guild_team_question_path(guild, team, question) : guild_team_questions_path(guild, team)),
        method: (question.persisted? ? :patch : :post),
        scope: :application_question, class: "space-y-2",
        data: { controller: "question-form" } do |f| %>
    <div class="flex items-center gap-2">
      <%= f.text_field :label, placeholder: "Question (max #{ApplicationQuestion::LABEL_MAX} chars)",
            maxlength: ApplicationQuestion::LABEL_MAX, class: "field flex-1 min-w-0" %>
      <%= f.select :style, ApplicationQuestion.style_options, {}, class: "field w-auto shrink-0",
            data: { question_form_target: "style", action: "question-form#toggle" } %>
      <%# A yes/no question is a single Discord checkbox, which can't be
          required — unticked just answers "No". %>
      <label class="flex items-center gap-1.5 text-sm text-muted-foreground shrink-0 px-1"
             data-question-form-target="field" data-styles="short paragraph choice checkboxes">
        <%= f.check_box :required, class: "field-checkbox" %> Required
      </label>
    </div>
    <%# Discord caps the question itself at 45 chars; the description sits
        beneath it in the modal, so a longer prompt goes here. %>
    <%= f.text_field :description,
          placeholder: "Description shown under the question — for longer prompts (optional, max #{ApplicationQuestion::DESCRIPTION_MAX} chars)",
          maxlength: ApplicationQuestion::DESCRIPTION_MAX, class: "field w-full" %>
    <div data-question-form-target="field" data-styles="short paragraph">
      <%= f.text_field :placeholder, placeholder: "Placeholder hint (optional)",
            maxlength: ApplicationQuestion::PLACEHOLDER_MAX, class: "field w-full" %>
    </div>
    <div data-question-form-target="field" data-styles="choice checkboxes">
      <%= f.text_area :options_text, rows: 4,
            placeholder: "One option per line — #{ApplicationQuestion::CHOICE_MIN}–#{ApplicationQuestion::OPTIONS_MAX} for multiple choice, up to #{ApplicationQuestion::OPTIONS_MAX} for checkboxes (max #{ApplicationQuestion::OPTION_MAX} chars each)",
            class: "field w-full" %>
    </div>
    <div class="flex justify-end">
      <%= f.submit (question.persisted? ? "Save" : "Add"), class: Ui::ButtonComponent.classes(variant: :gold) %>
    </div>
  <% end %>

  <% if question.persisted? %>
    <div class="mt-1.5 text-right">
      <%= button_to "Delete question", guild_team_question_path(guild, team, question), method: :delete,
            class: Ui::ButtonComponent.classes(variant: :danger, size: :sm),
            form: { data: { turbo_confirm: "Delete this question?" } } %>
    </div>
  <% end %>
</div>
