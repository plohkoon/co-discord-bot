<%# Shown to signed-in visitors who aren't in the Discord server yet. No team
    list, no forms — membership is the gate, and it's enforced server-side on
    the POST too, not just here. %>
<div class="max-w-lg mx-auto">
  <%= render Ui::CardComponent.new(padding: "p-8", classes: "text-center") do %>
    <h2 class="text-lg font-semibold text-foreground">You're not a member of this server yet</h2>
    <p class="mt-2 text-sm text-muted-foreground">
      Join <span class="text-foreground"><%= guild.name %></span> on Discord to apply to its teams —
      once you're in, reload this page.
    </p>
    <% if guild.invite_url.present? %>
      <div class="mt-6">
        <%= render Ui::ButtonComponent.new(href: guild.invite_url, variant: :gold) do %>
          Join <%= guild.name %> on Discord
        <% end %>
      </div>
    <% else %>
      <p class="mt-6 text-sm text-muted-foreground">
        This server hasn't set up an invite link — ask a server admin for an invite.
      </p>
    <% end %>
  <% end %>
</div>
