<% content_for :title, "Applications · #{@team.name}" %>

<%= render Ui::PageHeaderComponent.new(
      title: "Applications",
      back_href: guild_team_path(@guild, @team), back_label: @team.name,
      subtitle: "Every application to #{@team.name}, one row each.") do |header| %>
  <% header.with_actions do %>
    <%= link_to "Export CSV", guild_team_applications_path(@guild, @team, format: :csv, status: @report.status),
          class: Ui::ButtonComponent.classes(variant: :outline, size: :sm) %>
  <% end %>
<% end %>

<nav class="flex flex-wrap gap-2 mb-6 text-sm">
  <% [ [ "All", nil ], *Teams::ApplicationsReport::STATUSES.map { |s| [ s.capitalize, s ] } ].each do |label, value| %>
    <%= link_to label, guild_team_applications_path(@guild, @team, status: value),
          class: class_names("rounded-md px-3 py-1.5 transition",
                    @report.status == value ? "bg-secondary text-foreground" : "text-muted-foreground hover:text-foreground") %>
  <% end %>
</nav>

<% if @report.applications.empty? %>
  <%= render Ui::EmptyStateComponent.new do %>
    <%= @report.status ? "No #{@report.status} applications." : "No applications yet." %>
  <% end %>
<% else %>
  <div class="overflow-x-auto rounded-xl border border-border bg-card">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-border text-left text-xs uppercase tracking-wide text-muted-foreground">
          <th class="px-3 py-2 font-medium">Applicant</th>
          <th class="px-3 py-2 font-medium">Applied</th>
          <th class="px-3 py-2 font-medium">Status</th>
          <th class="px-3 py-2 font-medium">Character</th>
          <th class="px-3 py-2 font-medium">Spec / class</th>
          <% @report.columns.each do |column| %>
            <th class="px-3 py-2 font-medium min-w-40"><%= column.label %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @report.applications.each do |application| %>
          <% membership = application.team_membership %>
          <tr class="border-b border-border/50 last:border-0 hover:bg-secondary/40 align-top">
            <td class="px-3 py-2 whitespace-nowrap">
              <% name = application.discord_username.presence || membership&.discord_username.presence || application.discord_user_id %>
              <% if membership %>
                <%= link_to name, guild_team_membership_path(@guild, @team, membership), class: "font-medium text-gold hover:underline" %>
              <% else %>
                <span class="font-medium text-foreground"><%= name %></span>
              <% end %>
            </td>
            <td class="px-3 py-2 whitespace-nowrap text-muted-foreground"><%= application.created_at.strftime("%b %-d, %Y") %></td>
            <td class="px-3 py-2"><%= render StatusBadgeComponent.new(status: application.status) %></td>
            <td class="px-3 py-2 whitespace-nowrap text-muted-foreground">
              <%= Teams::ApplicationsReport.character_label(application) || "—" %>
            </td>
            <td class="px-3 py-2 whitespace-nowrap text-foreground">
              <%= application.wow_character&.spec_and_class || "—" %>
            </td>
            <% if application.manual? %>
              <td class="px-3 py-2 text-xs text-muted-foreground" colspan="<%= [ @report.columns.size, 1 ].max %>">Manual role grant — no answers.</td>
            <% else %>
              <% @report.answers_for(application).each do |answer| %>
                <td class="px-3 py-2 text-foreground">
                  <% if answer.nil? %>
                    <span class="text-muted-foreground/60" title="Not asked when they applied">—</span>
                  <% else %>
                    <div class="whitespace-pre-wrap line-clamp-4 max-w-xs" title="<%= answer %>"><%= answer.presence || "—" %></div>
                  <% end %>
                </td>
              <% end %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
