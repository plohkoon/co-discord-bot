<% content_for :title, "#{@guild.name} · co-bot" %>

<%= render Ui::PageHeaderComponent.new(title: @guild.name, back_href: root_path, back_label: "Servers") %>

<%= render "health_banner", health: @health if @health %>

<%= render Ui::SectionComponent.new(title: "Teams") do %>
  <% if can_manage? %>
    <div class="flex justify-end -mt-2 mb-3">
      <%= link_to "New team", new_guild_team_path(@guild.id), class: Ui::ButtonComponent.classes(variant: :gold, size: :sm) %>
    </div>
  <% end %>
  <% if @teams.empty? %>
    <%= render Ui::EmptyStateComponent.new do %>
      <% if can_manage? %>
        No teams yet. Create one here with <span class="text-foreground">New team</span>
        or in Discord with <code class="text-foreground bg-secondary px-1.5 py-0.5 rounded">/team create</code>.
      <% else %>
        No teams yet.
      <% end %>
    <% end %>
  <% else %>
    <div class="space-y-2">
      <% @teams.each do |team| %>
        <% openable = can_manage? || @led_team_ids.include?(team.id) %>
        <% row_body = capture do %>
          <div>
            <div class="font-medium text-foreground"><%= team.name %></div>
            <div class="text-xs text-muted-foreground mt-0.5">
              <%= @active_counts[team.id].to_i %> active ·
              <span class="<%= "text-gold" if @pending_counts[team.id].to_i.positive? %>"><%= @pending_counts[team.id].to_i %> pending</span> ·
              <%= pluralize(@question_counts[team.id].to_i, "question") %>
            </div>
          </div>
          <% if openable %><span class="text-muted-foreground">→</span><% end %>
        <% end %>
        <% if openable %>
          <%= link_to row_body, guild_team_path(@guild, team),
                class: "flex items-center justify-between rounded-xl border border-border bg-card hover:bg-secondary/40 px-4 py-3 transition" %>
        <% else %>
          <div class="flex items-center justify-between rounded-xl border border-border bg-card px-4 py-3">
            <%= row_body %>
          </div>
        <% end %>
      <% end %>
    </div>
  <% end %>
<% end %>

<% if @my_absences.present? %>
<%= render Ui::SectionComponent.new(title: "My call-outs", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    Days you told a team you'll miss (via <code class="text-muted-foreground bg-secondary px-1 py-0.5 rounded">/team absence</code>). Cancel one if plans change.
  </p>
  <div class="rounded-xl border border-border bg-card divide-y divide-border overflow-hidden">
    <% @my_absences.each do |absence| %>
      <div class="flex items-center gap-3 px-4 py-3">
        <div class="flex-1 min-w-0">
          <div class="text-sm text-foreground">
            <%= absence.absence_on.to_fs(:long) %>
            <span class="text-muted-foreground">· <%= absence.team.name %></span>
          </div>
          <% if absence.note.present? %>
            <div class="text-xs text-muted-foreground truncate"><%= absence.note %></div>
          <% end %>
        </div>
        <%= button_to "Cancel", guild_absence_path(@guild, absence), method: :delete,
              class: Ui::ButtonComponent.classes(variant: :ghost, size: :sm) %>
      </div>
    <% end %>
  </div>
<% end %>
<% end %>

<% if can_manage? %>
<%= render Ui::SectionComponent.new(title: "Server settings", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    The server's time zone anchors call-out days and the morning absence digest (posted at 8am local).
  </p>
  <%= form_with model: @guild, url: guild_path(@guild), method: :patch, scope: :guild,
        class: "rounded-lg border border-border bg-card p-4 flex flex-wrap items-end gap-3" do |f| %>
    <label class="block">
      <span class="text-xs text-muted-foreground">Time zone</span>
      <%= f.select :time_zone, options_for_select(ActiveSupport::TimeZone.all.map { |tz| [ tz.to_s, tz.name ] }, @guild.time_zone),
            {}, class: "field mt-1" %>
    </label>
    <%= f.submit "Save", class: Ui::ButtonComponent.classes(variant: :gold) %>
  <% end %>
<% end %>
<% end %>

<% if can_manage? %>
<%= render Ui::SectionComponent.new(title: "Public apply page", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    A shareable page listing this server's recruiting teams with web application forms.
    Visitors sign in with Discord; anyone not in the server yet sees the invite link below
    (each team page also has its own direct link).
  </p>
  <div class="rounded-xl border border-border bg-card p-5 space-y-4">
    <label class="block">
      <span class="text-xs text-muted-foreground">Share link</span>
      <%= text_field_tag :public_apply_url, public_guild_url(@guild.slug), readonly: true,
            class: "field w-full mt-1 select-all" %>
    </label>
    <%= form_with model: @guild, url: guild_path(@guild), method: :patch, scope: :guild,
          class: "flex flex-wrap items-end gap-3" do |f| %>
      <label class="block grow">
        <span class="text-xs text-muted-foreground">Link slug — lowercase letters, numbers and hyphens. Changing it breaks links you've already shared.</span>
        <%= f.text_field :slug, required: true, maxlength: SlugGenerator::MAX_LENGTH,
              pattern: "[a-z0-9]+(-[a-z0-9]+)*", class: "field w-full mt-1" %>
      </label>
      <label class="block grow">
        <span class="text-xs text-muted-foreground">Discord invite link — shown to non-members (blank shows "ask a server admin" instead)</span>
        <%= f.url_field :invite_url, placeholder: "https://discord.gg/…", class: "field w-full mt-1" %>
      </label>
      <%= f.submit "Save", class: Ui::ButtonComponent.classes(variant: :gold, size: :sm) %>
    <% end %>
  </div>
<% end %>
<% end %>

<% if can_manage? %>
<%= render Ui::SectionComponent.new(title: "Log channels", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    Pick where co-bot posts activity. The <span class="text-foreground">Important</span> channel
    catches new applications and unanswered auto-rejects; the <span class="text-foreground">Log</span>
    channel is a quieter audit trail (accepts, rejects, removals, new teams).
    Leave one blank to route everything to the other.
  </p>
  <% if @channel_options.empty? %>
    <div class="rounded-xl border border-destructive/40 bg-destructive/10 p-4 mb-4 text-sm text-foreground">
      Couldn't load this server's channels from Discord — make sure the bot is in the server, then reload.
    </div>
  <% end %>
  <%= form_with model: @guild, url: guild_path(@guild), method: :patch, scope: :guild,
        class: "rounded-xl border border-border bg-card p-5 space-y-4" do |f| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="block">
        <span class="text-xs text-muted-foreground">Important — applications &amp; alerts</span>
        <%= f.select :important_log_channel_id,
              options_for_select(@channel_options, @guild.important_log_channel_id&.to_s),
              { include_blank: "None" }, class: "field w-full mt-1" %>
      </label>
      <label class="block">
        <span class="text-xs text-muted-foreground">Log — audit trail</span>
        <%= f.select :log_channel_id,
              options_for_select(@channel_options, @guild.log_channel_id&.to_s),
              { include_blank: "None" }, class: "field w-full mt-1" %>
      </label>
    </div>
    <div class="flex justify-end">
      <%= f.submit "Save log channels", class: Ui::ButtonComponent.classes(variant: :gold, size: :sm) %>
    </div>
  <% end %>
<% end %>
<% end %>

<% if can_manage? %>
<%= render Ui::SectionComponent.new(title: "Events channel", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    Discord's own Events tab never posts to a channel. Pick one here and co-bot announces every
    server event when it's created, posts a "come join in" when it starts, and removes both an hour
    after it ends. Posts never ping anyone. Leave blank to turn this off.
  </p>
  <% if @channel_options.empty? %>
    <div class="rounded-xl border border-destructive/40 bg-destructive/10 p-4 mb-4 text-sm text-foreground">
      Couldn't load this server's channels from Discord — make sure the bot is in the server, then reload.
    </div>
  <% end %>
  <%= form_with model: @guild, url: guild_path(@guild), method: :patch, scope: :guild,
        class: "rounded-xl border border-border bg-card p-5 space-y-4" do |f| %>
    <label class="block sm:max-w-sm">
      <span class="text-xs text-muted-foreground">Events — announcements &amp; start nudges</span>
      <%= f.select :events_channel_id,
            options_for_select(@channel_options, @guild.events_channel_id&.to_s),
            { include_blank: "None" }, class: "field w-full mt-1" %>
    </label>
    <div class="flex justify-end">
      <%= f.submit "Save events channel", class: Ui::ButtonComponent.classes(variant: :gold, size: :sm) %>
    </div>
  <% end %>
<% end %>
<% end %>

<% if can_manage? %>
<%= render Ui::SectionComponent.new(title: "Roster settings", classes: "mt-12") do %>
  <p class="text-xs text-muted-foreground -mt-1 mb-4">
    Teams pick from these lists (here, on team pages, and via
    <code class="text-muted-foreground bg-secondary px-1 py-0.5 rounded">/team category|type</code> in Discord).
    Renames, reorders, and removals update any posted roster automatically.
  </p>
  <div class="grid gap-6 md:grid-cols-2">
    <div>
      <h3 class="text-xs text-muted-foreground mb-2">Categories (directory headers)</h3>
      <div class="space-y-3">
        <% @team_categories.each do |category| %>
          <%= render "roster_option", guild: @guild, record: category %>
        <% end %>
        <%= render "roster_option", guild: @guild, record: TeamCategory.new %>
      </div>
    </div>
    <div>
      <h3 class="text-xs text-muted-foreground mb-2">Team types</h3>
      <div class="space-y-3">
        <% @team_types.each do |team_type| %>
          <%= render "roster_option", guild: @guild, record: team_type %>
        <% end %>
        <%= render "roster_option", guild: @guild, record: TeamType.new %>
      </div>
    </div>
  </div>
<% end %>
<% end %>
