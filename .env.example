# Copy to `.env` and fill in. `.env` is gitignored; this template is committed.

# --- Discord bot (gateway) ---
# Developer Portal > your app > Bot > Reset Token
# ALSO enable on the Bot page:
#   - "Server Members Intent" — auto-syncs team memberships on manual role changes
#   - "Message Content Intent" — message actions (config/message_actions.rb) read
#     message text; without it no auto-reaction ever fires
# The web app also uses this token (REST only) for the per-guild permission
# health check on the dashboard.
DISCORD_BOT_TOKEN=

# --- Discord OAuth2 (web login) ---
# Developer Portal > your app > OAuth2. Add redirect:
#   http://localhost:3000/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Blizzard / Battle.net (WoW integrations) ---
# https://develop.battle.net > API Access > create a client.
# Used two ways: the `wow.profile` OAuth link (proves which characters a user
# owns) and a client-credentials token for public game/profile data. Optional —
# without it the Battle.net section of /account stays hidden.
#
# In the portal's Redirect URIs field, register EXACTLY:
#   http://localhost:3000/auth/battle_net/callback
# It must match character for character — scheme, port, path, no trailing slash.
# Plain http on localhost is fine; despite what several Blizzard forum threads
# say, https is NOT required. Note the path ends in /callback (not /client).
# A mismatch surfaces as a 400 "Invalid grant type or callback URL is not
# valid", which names the callback URL whatever the real cause was. (An
# unrecognized client_id gives 401 "Bad client credentials" instead, so a 400
# means your client was found and something about the request was refused.)
#
# The client-credentials half (public game data) needs no redirect URI at all.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=

# --- Raider.io (optional) ---
# Adds raid progression and the M+ score split by role, neither of which
# Blizzard exposes usably. Every endpoint used is PUBLIC — a key only raises the
# rate limit (200 req/min unauthenticated), so leaving this blank makes the
# integration slower, never broken. Register at https://raider.io/settings/apps
RAIDER_IO_API_KEY=

# --- Warcraft Logs (optional) ---
# Adds parse percentiles — how well someone actually played, which neither
# Blizzard nor Raider.io measures and which is what raid leads recruit on.
# Create a v2 API client at https://www.warcraftlogs.com/api/clients/ and use
# the "client credentials" pair (no redirect URI needed — this never acts on
# behalf of a user). Metered by POINTS, not requests: 3,600/hour.
# Unset, the whole WoW pipeline still works; parses are simply absent.
WARCRAFTLOGS_CLIENT_ID=
WARCRAFTLOGS_CLIENT_SECRET=

# Only needed when this app is reached at a different origin than the request
# host — behind a tunnel (ngrok/cloudflared) or a proxy. OmniAuth then builds
# its callback URLs from this instead of from the inbound request, and Rails'
# development host authorization allows the host through.
# Leave blank for plain http://localhost:3000.
APP_URL=

# --- Local development ---
# Use a SEPARATE Discord application for development (e.g. "co-bot dev"): a bot
# token shared with production would deliver every gateway event to both
# processes, and each would fight to answer interactions and sync commands.
# Production credentials live in Fly secrets, not in a .env file.

# Run the gateway bot in-process with `bin/rails server` (production style).
# Leave blank in development and run the bot via `bin/dev` (Procfile.dev) instead.
RUN_DISCORD_BOT=
